  m_Script: {fileID: 11500000, guid: 39307b13eff73ed41af5269e9ce6cbd3, type: 3}
  m_Name: NPC_KaptenNelayan_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: KaptenNelayan
    text: Ahoy, pelancong! Selamat datang di Dermaga Sungai Perak. Aku Kapten Bagas,
      pemimpin para nelayan di sini. Akhir-akhir ini ikan-ikan aneh bermunculan dari
      kedalaman sungai... Mungkin ada sesuatu yang mengganggu aliran air dari hutan
      timur!
  choices: []
